[Unit]
Description=Moon — High-Performance Redis-Compatible Server
Documentation=https://github.com/pilotspace/moon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=moon
Group=moon
ExecStart=/usr/bin/moon /etc/moon/moon.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
# A graceful stop runs the final RDB save (with save points; no deadline) and
# then drains the AOF writers (up to 60 s). systemd SIGKILLs after
# TimeoutStopSec (default 90s), losing what was not yet written. Size it to the
# final save of your dataset plus 60 s (docs/production-guide.md, "Graceful
# shutdown and stop timeouts"), e.g.:
#TimeoutStopSec=180

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/etc/moon
ReadWritePaths=/var/lib/moon /var/log/moon
LimitNOFILE=65536
LimitNPROC=4096

# OOM tuning — prefer killing other processes over moon
OOMScoreAdjust=-900

[Install]
WantedBy=multi-user.target
